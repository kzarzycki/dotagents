# Local overrides — never managed by install, never committed
**/*.local.*
**/.env*
**/settings.local.json
# Claude's runtime settings file lives only at ~/.claude/settings.json;
# the committed sources are settings.shared.json + settings.<profile>.json
home/.claude/settings.json

# Per-project state (machine-local)
home/.claude/projects/

# Runtime / cache (skipped by install, also never committed)
home/.claude/sessions/
home/.claude/history.jsonl
home/.claude/.credentials.json
home/.claude/cache/
home/.claude/debug/
home/.claude/backups/
home/.claude/file-history/
home/.claude/paste-cache/
home/.claude/plans/
home/.claude/session-env/
home/.claude/shell-snapshots/
home/.claude/tasks/
home/.claude/telemetry/
home/.claude/teams/
home/.claude/todos/
home/.claude/mcp-needs-auth-cache.json
home/.claude/.last-cleanup
home/.claude/plugins/

# Memsearch runtime (per-repo memory snapshot if memsearch runs inside this dir)
.memsearch/

# Local research, browser captures, and Python bytecode
.work/
.playwright-cli/
__pycache__/

# Project coding-agent installed payload and caches
apm_modules/
.agents/skills/
.claude/skills/

# Per-machine profile marker (~/.dotagents-profile is per-machine; not in repo
# but the .gitignore note documents the convention)

# omp (oh-my-pi) runtime state — only config is tracked under home/.omp/
home/.omp/agent/*.db*
home/.omp/agent/*.lock
home/.omp/agent/auth.json
home/.omp/agent/sessions/
home/.omp/agent/terminal-sessions/
home/.omp/agent/blobs/
home/.omp/agent/cache/
home/.omp/agent/skills/
home/.omp/agent/last-changelog-version
home/.omp/logs/
home/.omp/run/
home/.omp/cache/
home/.omp/natives/
home/.omp/puppeteer/
home/.omp/security/
home/.omp/install-id
home/.omp/*.json
home/.omp/*.db*
