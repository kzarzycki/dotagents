{
  "cleanupPeriodDays": 999999,
  "claudeInChromeDefaultEnabled": false,
  "env": {
    "BRIDGE_TLS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_TEAMMATE_MODE": "tmux",
    "MAX_THINKING_TOKENS": "32000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "330000",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_WORKFLOWS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://cc-experiments.taile39822.ts.net:4318",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_METRICS_INCLUDE_ACCOUNT_UUID": "false",
    "OTEL_METRICS_INCLUDE_REPOSITORY": "true",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_RESOURCE_ATTRIBUTES": "service.namespace=agents"
  },
  "permissions": {
    "allow": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.dotagents/patches/remote/refresh.sh",
            "timeout": 15,
            "statusMessage": "Refreshing dotagents..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.dotagents/patches/dev-marketplace/apply.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.hindsight/coding-agents/dist/claude-sessionstart-hook.js\" ]; then HINDSIGHT_API_LLM_PROVIDER=openai-codex HINDSIGHT_API_LLM_MODEL=gpt-6.1-sol node \"$HOME/.hindsight/coding-agents/dist/claude-sessionstart-hook.js\"; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.hindsight/coding-agents/dist/claude-hook.js\" ]; then HINDSIGHT_API_LLM_PROVIDER=openai-codex HINDSIGHT_API_LLM_MODEL=gpt-6.1-sol node \"$HOME/.hindsight/coding-agents/dist/claude-hook.js\"; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.hindsight/coding-agents/dist/claude-stop-hook.js\" ]; then HINDSIGHT_API_LLM_PROVIDER=openai-codex HINDSIGHT_API_LLM_MODEL=gpt-6.1-sol node \"$HOME/.hindsight/coding-agents/dist/claude-stop-hook.js\"; fi",
            "timeout": 60
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/omnigent-only.py\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/skills.git"
      }
    },
    "cli-anything": {
      "source": {
        "source": "github",
        "repo": "HKUDS/CLI-Anything"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "powerpoint-mcp": {
      "source": {
        "source": "github",
        "repo": "kzarzycki/powerpoint-mcp"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "kzarzycki-agent-skills": {
      "source": {
        "source": "github",
        "repo": "kzarzycki/agent-skills"
      }
    },
    "kzarzycki-agent-skills-private": {
      "source": {
        "source": "github",
        "repo": "kzarzycki/agent-skills-private"
      }
    },
    "dev": {
      "source": {
        "source": "directory",
        "path": "~/dev"
      }
    },
    "365-skills": {
      "source": {
        "source": "github",
        "repo": "Agents365-ai/365-skills"
      }
    },
    "pixelrag-plugins": {
      "source": {
        "source": "github",
        "repo": "StarTrail-org/PixelRAG"
      }
    }
  },
  "tui": "default",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "outputStyle": "Concise",
  "syncClaudeAiSkills": false,
  "autoMode": {
    "allow": [
      "$defaults",
      "Resolving a review thread on a pull request in the session's own repository (gh api graphql resolveReviewThread, one thread per call), after the lead has replied on it or a verdict deferred it. Does not cover any other GraphQL mutation in the same call, nor adding labels.",
      "Launching an Antigravity verifier through omnigent_agent.py `run antigravity-native-ui ... --role <...>/engineering-loop/verifier.md --permission-mode bypassPermissions --workspace <dir>`, where <dir> is a detached git worktree made for that review. The owner decided Antigravity may verify unattended with its approvals skipped, in its own throwaway worktree. Does not cover other agents, other roles, or a workspace that is a working checkout."
    ]
  }
}
