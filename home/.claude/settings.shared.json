{
  "cleanupPeriodDays": 999999,
  "claudeInChromeDefaultEnabled": false,
  "env": {
    "BRIDGE_TLS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_TEAMMATE_MODE": "tmux",
    "MAX_THINKING_TOKENS": "32000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "330000",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_WORKFLOWS": "1"
  },
  "permissions": {
    "allow": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.dotagents/patches/remote/refresh.sh",
            "timeout": 15,
            "statusMessage": "Refreshing dotagents..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.dotagents/patches/memsearch/apply.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash $HOME/.dotagents/patches/dev-marketplace/apply.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.orca/agent-hooks/claude-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\"; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "document-skills@anthropic-agent-skills": false,
    "cli-anything@cli-anything": false,
    "skill-creator@claude-plugins-official": false,
    "codex@openai-codex": false,
    "powerpoint-mcp@powerpoint-mcp": false,
    "superpowers@claude-plugins-official": false,
    "google-workspace@kzarzycki-agent-skills": false,
    "experimental@dev": false,
    "research@kzarzycki-agent-skills": false,
    "engineering@kzarzycki-agent-skills": false,
    "content@kzarzycki-agent-skills": false,
    "workflow@kzarzycki-agent-skills": false,
    "playwright@kzarzycki-agent-skills": false,
    "comms-personal@kzarzycki-agent-skills-private": false,
    "voice-personal@kzarzycki-agent-skills-private": false,
    "memsearch@memsearch-plugins": true,
    "drawio@365-skills": false,
    "pixelbrowse@pixelrag-plugins": false,
    "goal-creator@kzarzycki-agent-skills": false
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/skills.git"
      }
    },
    "cli-anything": {
      "source": {
        "source": "github",
        "repo": "HKUDS/CLI-Anything"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "powerpoint-mcp": {
      "source": {
        "source": "github",
        "repo": "kzarzycki/powerpoint-mcp"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "kzarzycki-agent-skills": {
      "source": {
        "source": "github",
        "repo": "kzarzycki/agent-skills"
      }
    },
    "kzarzycki-agent-skills-private": {
      "source": {
        "source": "github",
        "repo": "kzarzycki/agent-skills-private"
      }
    },
    "memsearch-plugins": {
      "source": {
        "source": "github",
        "repo": "zilliztech/memsearch"
      }
    },
    "dev": {
      "source": {
        "source": "directory",
        "path": "~/dev"
      }
    },
    "365-skills": {
      "source": {
        "source": "github",
        "repo": "Agents365-ai/365-skills"
      }
    },
    "pixelrag-plugins": {
      "source": {
        "source": "github",
        "repo": "StarTrail-org/PixelRAG"
      }
    }
  },
  "tui": "default",
  "autoMemoryEnabled": false,
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "outputStyle": "Concise"
}
