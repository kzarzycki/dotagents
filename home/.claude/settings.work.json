{
  "enabledPlugins": {
    "code-mode@claude-mods": false
  },
  "permissions": {
    "deny": []
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "dotagents": {
    "dropDeny": ["Bash", "Read", "Edit", "Write", "Glob", "Grep", "NotebookEdit"],
    "telemetryRepos": [
      "github.com/kzarzycki/agent-skills",
      "github.com/kzarzycki/dotagents",
      "github.com/kzarzycki/flowbench",
      "github.com/kzarzycki/claude-mods",
      "github.com/kzarzycki/project-templates",
      "github.com/kzarzycki/omnigent"
    ]
  },
  "pluginConfigs": {
    "decision-model@claude-mods": {
      "options": {
        "backend": "claude"
      }
    }
  }
}
