# One alias per agent host, same on every machine. Installed by dotagents and
# pulled into ~/.ssh/config by an Include line that `dotagents install` adds.
# HostName is the host's tailnet name; User is the account agents run as there.
Host kris
  HostName kriss-macbook-pro.taile39822.ts.net
  User kris
Host xmac-personal
  HostName krzysztofs-macbook-pro.taile39822.ts.net
  User personal
Host oz
  HostName oz.taile39822.ts.net
  User agent
Host epic-t2
  HostName epic-t2.taile39822.ts.net
  User agent
Host cc-experiments
  HostName cc-experiments.taile39822.ts.net
  User agent
# kris's default key has a passphrase, so agents there use a passphrase-less
# key of their own; ssh skips an identity file a host doesn't have.
Host kris xmac-personal oz epic-t2 cc-experiments
  IdentityFile ~/.ssh/id_ed25519_agent
  IdentityFile ~/.ssh/id_ed25519
