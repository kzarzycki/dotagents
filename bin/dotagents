#!/usr/bin/env bash
# dotagents — install/manage symlinks from $HOME into the dotagents repo.
# Usage:
#   dotagents install [--no-pull] [--dry-run] [--profile <name>] [--only <entry>]
#
# Install is idempotent. The tree under <repo>/home/ is mirrored into $HOME:
# directories are recreated as real directories, files are symlinked back into
# the repo (so home/.omp/agent/config.yml lands at ~/.omp/agent/config.yml
# without swallowing the live state next to it). Existing real files at
# destinations are left alone and reported as conflicts. Local-override
# patterns are skipped.
#
# Profile: machine-class overlay name (mac, vps, remote, ...). If not
# supplied via --profile and $HOME/.dotagents-profile is missing, prompts on
# a TTY. Resolved value is written to $HOME/.dotagents-profile.

set -euo pipefail

# Locate the repo root: dir containing this script's parent. Install links
# ~/.local/bin/dotagents to it, so follow links to the script itself first
# (by hand: older macOS readlink has no -f).
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  self_link=$(readlink "$self")
  case "$self_link" in /*) self=$self_link ;; *) self="$(dirname "$self")/$self_link" ;; esac
done
SCRIPT_DIR="$(cd "$(dirname "$self")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DOTAGENTS_LINK="$HOME/.dotagents"
SRC="$REPO_ROOT/home"

CMD="${1:-}"
shift || true

case "$CMD" in
  install)
    ;;
  arm-hooks)
    ;;
  doctor)
    ;;
  ""|-h|--help|help)
    cat <<EOF
dotagents — install ~/ symlinks from this repo

Usage:
  dotagents install [--no-pull] [--dry-run] [--profile <name>] [--only <entry>]
  dotagents arm-hooks [--root <path>]... [--install-hooks] [--dry-run]
  dotagents doctor   Report each tool a skill declares that the host lacks or
                     has too old, and each copy of a skill script the pinned
                     pack doesn't have. Silent and 0 when clean, else 1.

Options:
  --no-pull          Skip the git pull step.
  --dry-run          Print actions without making changes.
  --profile <name>   Machine-class profile (mac, vps, remote, ...);
                     comma-separated to stack overlays, e.g. mac,work.
                     Written to ~/.dotagents-profile. If omitted and the
                     file is missing, prompts on a TTY.
  --only <entry>     Install only this top-level home payload; repeatable.
                     An optional leading dot is accepted.
  --root <path>      (arm-hooks) A directory to sweep for already-cloned repos
                     to arm. Repeatable. Defaults to ~/dev. Each runtime passes
                     the path where its harness drops work repos.
  --install-hooks    (arm-hooks) Pre-warm hook environments now instead of
                     lazily on first commit.
EOF
    exit 0
    ;;
  *)
    echo "dotagents: unknown command: $CMD" >&2
    exit 2
    ;;
esac

NO_PULL=0
DRY_RUN=0
PROFILE_ARG=""
INSTALL_HOOKS=0
ROOTS=()
ONLY_ARGS=()
while (( $# )); do
  case "$1" in
    --no-pull) NO_PULL=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --only)
      shift || { echo "dotagents: --only requires a value" >&2; exit 2; }
      [ $# -gt 0 ] || { echo "dotagents: --only requires a value" >&2; exit 2; }
      ONLY_ARGS+=("$1")
      ;;
    --only=*)
      [ -n "${1#--only=}" ] || { echo "dotagents: --only requires a value" >&2; exit 2; }
      ONLY_ARGS+=("${1#--only=}")
      ;;
    --install-hooks) INSTALL_HOOKS=1 ;;
    --root)
      shift || { echo "dotagents: --root requires a value" >&2; exit 2; }
      ROOTS+=("$1")
      ;;
    --root=*) ROOTS+=("${1#--root=}") ;;
    --profile)
      shift || { echo "dotagents: --profile requires a value" >&2; exit 2; }
      PROFILE_ARG="$1"
      ;;
    --profile=*) PROFILE_ARG="${1#--profile=}" ;;
    *) echo "dotagents: unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

ONLY_MODE=0
ONLY_DIRS=()
if (( ${#ONLY_ARGS[@]} > 0 )); then
  [ "$CMD" = "install" ] || {
    echo "dotagents: --only is valid only with install" >&2
    exit 2
  }
  ONLY_MODE=1
  for only_arg in "${ONLY_ARGS[@]}"; do
    only_name="${only_arg#.}"
    case "$only_name" in
      ""|.*|*/*)
        echo "dotagents: unsupported --only value: $only_arg" >&2
        exit 2
        ;;
    esac
    only_dir=".$only_name"
    [ -d "$SRC/$only_dir" ] || only_dir="$only_name"
    if [ ! -d "$SRC/$only_dir" ]; then
      echo "dotagents: unsupported --only value: $only_arg" >&2
      exit 2
    fi
    duplicate=0
    for selected_dir in ${ONLY_DIRS[@]+"${ONLY_DIRS[@]}"}; do
      if [ "$selected_dir" = "$only_dir" ]; then
        duplicate=1
        break
      fi
    done
    (( duplicate )) || ONLY_DIRS+=("$only_dir")
  done
fi

is_selected() {
  local name="$1" selected
  (( ! ONLY_MODE )) && return 0
  for selected in ${ONLY_DIRS[@]+"${ONLY_DIRS[@]}"}; do
    [ "$selected" = "$name" ] && return 0
  done
  return 1
}
run() {
  if (( DRY_RUN )); then
    printf 'DRY: %s\n' "$*"
  else
    "$@"
  fi
}

# Arm the pre-commit *framework* (each repo's .pre-commit-config.yaml: ruff,
# gitleaks, ...) so a bad commit fails locally before CI. Two idempotent halves:
# (a) git's template dir auto-arms every FUTURE clone/init; (b) a depth-limited
# sweep installs the pre-commit dispatcher in EVERY already-cloned git repo
# under each root — not just ones with a config today, so a config added later
# auto-runs (the dispatcher no-ops where there's no config). It NEVER touches a
# maintainer's own hook setup: repos using core.hooksPath (husky, tracked
# .githooks, ...) and repos that already have their own .git/hooks/pre-commit are
# skipped, not chained. Per-repo install only, never global core.hooksPath; a
# fresh install honors the repo's default_install_hook_types. Best-effort: if
# pre-commit can't be obtained, warn and return — CI stays the backstop.
arm_precommit_hooks() {
  if ! command -v pre-commit >/dev/null 2>&1 && command -v uv >/dev/null 2>&1; then
    run uv tool install pre-commit >/dev/null 2>&1 || true
  fi
  if ! command -v pre-commit >/dev/null 2>&1; then
    printf 'NOTE: pre-commit unavailable (uv could not install it) — framework hooks not armed; CI still enforces\n'
    return 0
  fi

  # The guard hook (committed): blocks commits past shipped-but-inactive
  # maintainer hooks AND delegates to the pre-commit framework. Deployed into
  # the template and every swept repo.
  local guard="$REPO_ROOT/lib/precommit-guard.sh"
  if [ ! -f "$guard" ]; then
    printf 'NOTE: %s missing — cannot arm hooks\n' "$guard"
    return 0
  fi

  # (a) future clones: git copies this template's hooks into every new repo.
  local tpl="$HOME/.config/git/template"
  run pre-commit init-templatedir "$tpl" >/dev/null 2>&1 || true
  run mkdir -p "$tpl/hooks"
  run cp "$guard" "$tpl/hooks/pre-commit"
  run chmod +x "$tpl/hooks/pre-commit"
  # post-checkout also fires in clones tools make (SwiftPM, submodules): the
  # guard runs it only where the repo opted in, and never fails the checkout.
  run cp "$REPO_ROOT/lib/postcheckout-guard.sh" "$tpl/hooks/post-checkout"
  run chmod +x "$tpl/hooks/post-checkout"
  if [ "$(git config --global --get init.templateDir 2>/dev/null || true)" != "$tpl" ]; then
    run git config --global init.templateDir "$tpl"
    printf 'HOOKED: git init.templateDir -> %s (future clones)\n' "$tpl"
  fi

  # (b) sweep every git repo under each root; arm only where it's safe.
  local extra=()
  (( INSTALL_HOOKS )) && extra=(--install-hooks)
  local root gitdir repo hook hp
  for root in "$@"; do
    [ -d "$root" ] || continue
    while IFS= read -r gitdir; do
      repo=$(dirname "$gitdir")
      git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || continue
      # Respect a maintainer-chosen hooks dir: core.hooksPath bypasses .git/hooks
      # entirely (husky, tracked .githooks). Installing there would be dead or
      # fight their setup — skip (the guard itself nudges you to wire it up).
      hp=$(git -C "$repo" config --get core.hooksPath 2>/dev/null || true)
      if [ -n "$hp" ]; then
        (( DRY_RUN )) && printf 'SKIP (core.hooksPath=%s): %s\n' "$hp" "$repo"
        continue
      fi
      hook="$repo/.git/hooks/pre-commit"
      if [ -f "$hook" ]; then
        if cmp -s "$guard" "$hook"; then
          (( INSTALL_HOOKS )) || continue   # already current guard
        elif ! grep -q "dotagents-hook-guard\|File generated by pre-commit" "$hook" 2>/dev/null; then
          # A foreign hook already lives here — someone's own setup. Leave it
          # strictly alone (don't clobber, don't chain via .legacy).
          printf 'SKIP (repo has its own pre-commit hook): %s\n' "$repo"
          continue
        fi
        # else: our older guard, or a plain pre-commit hook — safe to replace.
      fi
      if (( DRY_RUN )); then
        printf 'DRY: arm %s\n' "$repo"
        continue
      fi
      # Install the OTHER configured hook types (commit-msg, pre-push) via
      # pre-commit, then overlay our guard onto the pre-commit-stage hook.
      if [ -f "$repo/.pre-commit-config.yaml" ]; then
        ( cd "$repo" && pre-commit install ${extra[@]+"${extra[@]}"} ) >/dev/null 2>&1 || true
      fi
      run mkdir -p "$repo/.git/hooks"
      # A `pre-commit install` run over an older guard parked it as .legacy;
      # pre-commit would keep running that stale copy before ours. Drop it.
      if [ -f "$hook.legacy" ] && grep -q "dotagents-hook-guard" "$hook.legacy" 2>/dev/null; then
        run rm "$hook.legacy"
      fi
      if cp "$guard" "$hook" && chmod +x "$hook"; then
        printf 'HOOKED: %s\n' "$repo"
      else
        printf 'WARN: could not arm %s\n' "$repo"
      fi
    done < <(find "$root" -maxdepth 5 \
               \( -name node_modules -o -name .venv \) -prune \
               -o -type d -name .git -print -prune 2>/dev/null)
  done
}

if [ "$CMD" = "arm-hooks" ]; then
  if (( ${#ROOTS[@]} == 0 )); then ROOTS=("$HOME/dev"); fi
  arm_precommit_hooks "${ROOTS[@]}"
  exit 0
fi

# Skill requirements. A skill declares the tools its scripts need in its SKILL.md
# frontmatter, `metadata.requires: "gh>=2.99.0 vhs"` (agent-skills' conventions),
# where each name is both the command and its mise tool. The skills a host's
# agents load are this checkout's pinned pack (installed by `mise run setup:dev`)
# and the global skill dirs; the pinned pack is the reference for which scripts
# a skill has.
PINNED_SKILLS="$REPO_ROOT/.agents/skills"
SKILL_DIRS=("$PINNED_SKILLS" "$HOME/.claude/skills" "$HOME/.claude-knowledge/skills" "$HOME/.agents/skills" "$HOME/.codex/skills")
MISE_SHIMS="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
# What an agent shell resolves: env.sh puts ~/.local/bin first and mise's shims last.
# Homebrew's bin dirs are added for a scheduler's minimal PATH, which a login
# shell's brew shellenv never set.
AGENT_PATH="$HOME/.local/bin:$PATH:/opt/homebrew/bin:/usr/local/bin:$MISE_SHIMS"

# One line per declared entry: tool|minimum version (empty for a bare tool)|skill.
skill_requirements() {
  local files=() d
  for d in "${SKILL_DIRS[@]}"; do
    [ -d "$d" ] && for f in "$d"/*/SKILL.md; do [ -f "$f" ] && files+=("$f"); done
  done
  (( ${#files[@]} )) || return 0
  # ponytail: line-based frontmatter read, expects `requires:` indented under a
  # top-level `metadata:`; a flow mapping (metadata: {requires: ..}) is missed.
  awk '
    FNR == 1 { fm = ($0 == "---"); parent = ""; next }
    !fm { next }
    $0 == "---" { fm = 0; next }
    /^[^[:space:]#][^:]*:/ { parent = $0; sub(/:.*/, "", parent); next }
    parent == "metadata" && /^[[:space:]]+requires:/ {
      v = $0; sub(/^[^:]*:[[:space:]]*/, "", v); gsub(/["'\'']/, "", v)
      skill = FILENAME; sub(/\/SKILL\.md$/, "", skill); sub(/.*\//, "", skill)
      n = split(v, entries, /[[:space:]]+/)
      for (i = 1; i <= n; i++) {
        if (entries[i] == "") continue
        tool = entries[i]; min = ""
        if (index(tool, ">=")) { min = substr(tool, index(tool, ">=") + 2); tool = substr(tool, 1, index(tool, ">=") - 1) }
        print tool "|" min "|" skill
      }
    }' "${files[@]}"
}

# The first dotted number a tool's --version prints, from an agent shell's PATH.
tool_version() {
  PATH="$AGENT_PATH" "$1" --version 2>/dev/null | grep -Eom1 '[0-9]+(\.[0-9]+)+' || true
}

version_ge() {
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$2" ]
}

# 0 when an agent shell's tool meets the minimum; REQ_HAVE is the version it found.
requirement_met() {
  REQ_HAVE=$(tool_version "$1")
  PATH="$AGENT_PATH" command -v "$1" >/dev/null 2>&1 || return 1
  [ -z "$2" ] || { [ -n "$REQ_HAVE" ] && version_ge "$REQ_HAVE" "$2"; }
}

# Prints one finding per unmet requirement; returns 1 if there is any.
check_requirements() {
  local tool min skill found=0
  while IFS='|' read -r tool min skill; do
    requirement_met "$tool" "$min" && continue
    found=1
    if PATH="$AGENT_PATH" command -v "$tool" >/dev/null 2>&1; then
      printf 'too old: %s %s, skill %s needs >= %s\n' "$tool" "${REQ_HAVE:-(no version)}" "$skill" "$min"
    else
      printf 'missing: %s%s, needed by skill %s\n' "$tool" "${min:+ >= $min}" "$skill"
    fi
  done < <(skill_requirements)
  return "$found"
}

# A skill script, in a skill path an agent loads (a project's or the global
# .claude, .agents or .codex skills), that the pinned pack's skill of that name
# doesn't have: an old pin, an old clone's install, a second copy of the skill.
# A project whose apm.lock.yaml deploys that skill at a newer version than this
# checkout's lock is skipped: its copy is ahead, not stale. Source trees, package
# stores and the apm cache are no skill path. One line per skill directory
# holding such scripts. Caches (.cache, and .tmp, where Codex clones its
# marketplaces) and tmp dirs (a loop's evidence copies of other repos) are no
# skill path either. Gitignored paths are scanned: a project's installed skill
# dirs are gitignored.
check_stale_skill_copies() {
  [ -d "$PINNED_SKILLS" ] || {
    printf 'no pinned pack: run `mise run setup:dev` in %s\n' "$REPO_ROOT"
    return 1
  }
  local pinned_real
  pinned_real=$(cd "$PINNED_SKILLS" && pwd -P)
  # ponytail: a directory the account can't read (macOS TCC folders without Full
  # Disk Access) is skipped silently; report it if a skill path ever lives there.
  { find "$HOME" \( -name .git -o -name node_modules -o -name apm_modules -o -name __pycache__ \
      -o -name Library -o -name .Trash -o -name .cache -o -name .tmp -o -name tmp \) -prune \
      -o \( -path '*/.claude/skills/*/scripts/*' -o -path '*/.agents/skills/*/scripts/*' \
      -o -path '*/.claude-knowledge/skills/*/scripts/*' -o -path '*/.codex/skills/*/scripts/*' \) \
      -type f -print 2>/dev/null || true; } \
    | awk -v pinned="$PINNED_SKILLS" -v pinned_real="$pinned_real" -v pinned_lock="$REPO_ROOT/apm.lock.yaml" '
      # The version of the apm.lock.yaml dependency that deploys skill `name`, or "".
      function lockver(file, name,   line, ver, v) {
        while ((getline line < file) > 0) {
          if (line ~ /^- /) ver = ""
          if (line ~ /^  version: /) { ver = line; sub(/^  version: /, "", ver); gsub(/["'\'']/, "", ver) }
          if (line ~ ("^  - [.][a-z-]+/skills/" name "$")) v = ver
        }
        close(file); return v
      }
      function newer(a, b,   x, y, k, n) {
        n = split(a, x, "."); split(b, y, ".")
        for (k = 1; k <= n || k in y; k++) if (x[k] + 0 != y[k] + 0) return x[k] + 0 > y[k] + 0
        return 0
      }
      BEGIN {
        cmd = "cd \"" pinned "\" && find . -path \"./*/scripts/*\" -type f"
        while ((cmd | getline f) > 0) { sub(/^\.\//, "", f); ref[f] = 1; split(f, p, "/"); skill[p[1]] = 1 }
        close(cmd)
      }
      index($0, pinned "/") == 1 || index($0, pinned_real "/") == 1 { next }
      {
        i = match($0, /\/\.(claude|claude-knowledge|agents|codex)\/skills\/[^\/]+\/scripts\//); if (!i) next
        root = substr($0, 1, i - 1)
        i = i + index(substr($0, i + 1), "/")
        rel = substr($0, i + 8); split(rel, p, "/")
        if ((p[1] in skill) && !(rel in ref)) {
          dir = substr($0, 1, i + 7) p[1]
          if (!(dir in seen)) { seen[dir] = 1; order[++n] = dir; sk[dir] = p[1]; top[dir] = root }
          files[dir] = files[dir] " " substr(rel, length(p[1]) + 10)
        }
      }
      END {
        for (k = 1; k <= n; k++) {
          d = order[k]; have = lockver(top[d] "/apm.lock.yaml", sk[d]); pin = lockver(pinned_lock, sk[d])
          if (have != "" && pin != "" && newer(have, pin)) continue
          printf "stale skill copy: %s:%s\n", d, files[d]; found = 1
        }
        exit found
      }'
}

if [ "$CMD" = "doctor" ]; then
  doctor_status=0
  check_requirements || doctor_status=1
  check_stale_skill_copies || doctor_status=1
  exit "$doctor_status"
fi

# The merged settings feed both ~/.claude/settings.json and Codex's [otel].
if is_selected ".claude" || is_selected ".codex"; then
# 0. Resolve profile. Precedence: --profile arg > existing ~/.dotagents-profile
# > interactive prompt. Resolved value is persisted to ~/.dotagents-profile
# so subsequent runs need no flag.
PROFILE_FILE="$HOME/.dotagents-profile"
resolved_profile=""
if [ -n "$PROFILE_ARG" ]; then
  resolved_profile="$PROFILE_ARG"
elif [ -f "$PROFILE_FILE" ]; then
  resolved_profile=$(head -1 "$PROFILE_FILE" | tr -d '\n\r ')
fi

if [ -z "$resolved_profile" ]; then
  available=()
  for f in "$SRC"/.claude/settings.*.json; do
    [ -e "$f" ] || continue
    n=$(basename "$f")
    n=${n#settings.}
    n=${n%.json}
    [ "$n" = "shared" ] && continue
    available+=("$n")
  done
  if [ -t 0 ]; then
    printf 'Profile name, comma-separated to stack (available: %s): ' "${available[*]:-mac vps}" >&2
    read -r resolved_profile
    resolved_profile=$(printf '%s' "$resolved_profile" | tr -d '\n\r ')
  fi
fi

if [ -n "$resolved_profile" ]; then
  current=""
  [ -f "$PROFILE_FILE" ] && current=$(head -1 "$PROFILE_FILE" | tr -d '\n\r ')
  if [ "$current" != "$resolved_profile" ]; then
    if (( DRY_RUN )); then
      printf 'DRY: write profile "%s" to %s\n' "$resolved_profile" "$PROFILE_FILE"
    else
      printf '%s\n' "$resolved_profile" > "$PROFILE_FILE"
    fi
  fi
else
  echo "dotagents: no profile set (no --profile, no $PROFILE_FILE, no TTY); per-machine overlay will be skipped" >&2
fi
fi

# 1. git pull
if (( ! ONLY_MODE && ! NO_PULL )); then
  if [ -d "$REPO_ROOT/.git" ]; then
    if git -C "$REPO_ROOT" remote | grep -q .; then
      run git -C "$REPO_ROOT" pull --ff-only
    else
      echo "dotagents: no git remote configured; skipping pull"
    fi
  fi
fi

# 1.5 Enable the repo's tracked git hooks on this clone. core.hooksPath is
# per-clone local config (not committable), so wire it here — the install
# everyone already runs becomes the one-step opt-in. Idempotent.
if (( ! ONLY_MODE )) && [ -d "$REPO_ROOT/.git" ] && [ -d "$REPO_ROOT/.githooks" ]; then
  current_hooks=$(git -C "$REPO_ROOT" config --local --get core.hooksPath || true)
  if [ "$current_hooks" != ".githooks" ]; then
    run git -C "$REPO_ROOT" config --local core.hooksPath .githooks
    printf 'HOOKED: %s git hooks -> .githooks (gitleaks/json/symlink pre-commit)\n' "$REPO_ROOT"
  fi
fi

# Retire project files written by the removed toolkit SessionStart hook. Only
# delete the Codex file when its generator marker proves ownership. The other
# generated files had no safe marker and are left for explicit project cleanup.
LEGACY_TOOLKIT_CODEX="$REPO_ROOT/.codex/config.toml"
if (( ! ONLY_MODE )) && [ -f "$LEGACY_TOOLKIT_CODEX" ]; then
  legacy_marker=$(head -1 "$LEGACY_TOOLKIT_CODEX")
  if [ "$legacy_marker" = '# generated by dotagents toolkit hook' ]; then
    run rm "$LEGACY_TOOLKIT_CODEX"
  fi
fi

# The hook added these machine-local excludes when it first materialized this
# repository. Remove only its exact entries; keep unrelated runtime excludes.
GIT_EXCLUDE="$REPO_ROOT/.git/info/exclude"
if (( ! ONLY_MODE )) && [ -f "$GIT_EXCLUDE" ] && grep -Eq '^(\.mcp\.json|\.claude/\.toolkit-stamp|/?\.codex/|\.claude/skills/|\.claude/settings\.local\.json)$' "$GIT_EXCLUDE"; then
  if (( DRY_RUN )); then
    printf 'DRY: remove retired toolkit entries from %s\n' "$GIT_EXCLUDE"
  else
    exclude_tmp=$(mktemp)
    grep -Ev '^(\.mcp\.json|\.claude/\.toolkit-stamp|/?\.codex/|\.claude/skills/|\.claude/settings\.local\.json)$' "$GIT_EXCLUDE" > "$exclude_tmp" || true
    cp "$exclude_tmp" "$GIT_EXCLUDE"
    rm "$exclude_tmp"
  fi
fi

# 1.6 Arm the pre-commit framework (template dir for future clones + sweep of
# already-cloned repos under ~/dev). Distinct from 1.5's dotagents-only
# .githooks. See arm_precommit_hooks. Other runtimes call `dotagents arm-hooks
# --root <their path>` directly (remote-setup.sh does, for container checkouts).
if (( ! ONLY_MODE )); then
  arm_precommit_hooks "$HOME/dev"
fi

if (( ! ONLY_MODE )) || is_selected ".claude"; then
# 2. Ensure $HOME/.dotagents resolves to $REPO_ROOT. Committed
# settings.shared.json references this path for hook commands.
#   - Repo cloned at $HOME/.dotagents itself: nothing to do.
#   - $HOME/.dotagents is a symlink: ensure it points at $REPO_ROOT.
#   - $HOME/.dotagents is a real path different from $REPO_ROOT: conflict.
#   - Missing: create symlink.
if [ "$REPO_ROOT" = "$DOTAGENTS_LINK" ]; then
  :  # repo is canonical clone path; no symlink needed
elif [ -L "$DOTAGENTS_LINK" ]; then
  current_target=$(readlink "$DOTAGENTS_LINK")
  if [ "$current_target" != "$REPO_ROOT" ]; then
    run ln -sfn "$REPO_ROOT" "$DOTAGENTS_LINK"
  fi
elif [ -e "$DOTAGENTS_LINK" ]; then
  printf 'CONFLICT: %s exists and is not a symlink — leaving alone\n' "$DOTAGENTS_LINK"
else
  run ln -sfn "$REPO_ROOT" "$DOTAGENTS_LINK"
fi
fi

# Remove retired payload links whose sources no longer exist, so the normal
# payload walk cannot replace or remove them.
remove_retired_payload_link() {
  local installed="$1"
  local source_relative="$2"
  local retired_target

  [ -L "$installed" ] || return 0
  retired_target=$(readlink "$installed")
  case "$retired_target" in
    "$SRC/$source_relative"|"$DOTAGENTS_LINK/home/$source_relative")
      run rm "$installed"
      ;;
  esac
}

if (( ! ONLY_MODE )); then
remove_retired_payload_link "$HOME/.agents/mcp-registry.json" ".agents/mcp-registry.json"
remove_retired_payload_link "$HOME/.claude/hooks" ".claude/hooks"
remove_retired_payload_link "$HOME/.agents/rules" ".agents/rules"
remove_retired_payload_link "$HOME/.config/ponytail/config.json" ".config/ponytail/config.json"
fi

# Remove symlinks created by older dotagents versions that vendored Claude
# skills. Skills now come from plugins/marketplaces, not this repo.
is_legacy_skill_link() {
  local target="$1"
  local suffix=""

  case "$target" in
    "$HOME/.agents/.skill-lock.json") suffix="/.agents/.skill-lock.json" ;;
    "$HOME/.agents/skills") suffix="/.agents/skills" ;;
    "$HOME/.claude/skills") suffix="/.claude/skills" ;;
    *) return 1 ;;
  esac

  [ -L "$target" ] || return 1

  # Old dotagents linked these into the repo's home/ payload, addressed either
  # directly ($REPO_ROOT/home/...) or via the $HOME/.dotagents symlink. The two
  # forms resolve to the same place but are different strings, so match both.
  # Skills are no longer vendored, so any such link is stale.
  local link src_rel
  link=$(readlink "$target")
  src_rel="${SRC#$REPO_ROOT}"          # e.g. /home
  case "$link" in
    "$SRC$suffix"|"$DOTAGENTS_LINK$src_rel$suffix") return 0 ;;
  esac
  return 1
}

remove_legacy_skill_link() {
  local target="$1"

  if is_legacy_skill_link "$target"; then
    run rm "$target"
  fi
}

if (( ! ONLY_MODE )); then
remove_legacy_skill_link "$HOME/.agents/.skill-lock.json"
remove_legacy_skill_link "$HOME/.agents/skills"
remove_legacy_skill_link "$HOME/.claude/skills"
fi

# 2.5 Install the pinned pack (.agents/skills, gitignored) at the version
# apm.lock.yaml pins whenever the lock differs from the one last installed here:
# ~/.local/bin links into its scripts, and 4.8 and doctor read it, so a pull that
# moves the pin must reach it. `apm install --frozen` installs exactly the lock
# and changes no tracked file. A failure is a warning; the next install retries.
PACK_STAMP="$HOME/.local/state/dotagents/pinned-pack.lock"
if { (( ! ONLY_MODE )) || is_selected ".agents"; } && [ -f "$REPO_ROOT/apm.lock.yaml" ] \
  && { [ ! -d "$PINNED_SKILLS" ] || ! cmp -s "$REPO_ROOT/apm.lock.yaml" "$PACK_STAMP"; }; then
  if (( DRY_RUN )); then
    printf 'DRY: cd %s && mise exec -- apm install --frozen\n' "$REPO_ROOT"
  elif (cd "$REPO_ROOT" && mise exec -- apm install --frozen >/dev/null); then
    mkdir -p "${PACK_STAMP%/*}"
    cp "$REPO_ROOT/apm.lock.yaml" "$PACK_STAMP"
    printf 'INSTALLED: the pinned pack in %s at its apm.lock.yaml\n' "$PINNED_SKILLS"
  else
    printf 'WARNING: could not install the pinned pack in %s (apm install --frozen); the next install retries\n' "$REPO_ROOT" >&2
  fi
fi

# 3. Walk home/ and link each item under each agent dir.
shopt -s nullglob dotglob

# Patterns to never link.
is_skipped() {
  local name="$1"
  case "$name" in
    *.local.*|.env*|settings.local.json|projects|__pycache__|.skill-lock.json|skills|*.lock) return 0 ;;
    # Per-profile settings files — picked up via $HOME/.dotagents-profile,
    # never linked as ~/.<dotdir>/settings.<profile>.json directly.
    settings.*.json) return 0 ;;
    # cache / runtime — also belt-and-braces here in case .gitignore is stale
    sessions|history.jsonl|.credentials.json|cache|debug|backups|\
    file-history|paste-cache|plans|session-env|shell-snapshots|tasks|\
    telemetry|teams|todos|mcp-needs-auth-cache.json|.last-cleanup|plugins)
      return 0 ;;
  esac
  return 1
}

linked=0; skipped=0; conflicts=0; agents_seen=0
RULES_MARK='# Installed by dotagents (home/.codex/rules/)'

# Mirror the repo tree: directories are recreated as real dirs at the
# destination, only files are symlinked (Codex rules files are copied, below). Linking a whole directory would make
# an agent's live state (~/.omp/agent holds sqlite dbs and sessions) land
# inside the repo, so dirs are never links — nesting like
# home/.omp/agent/config.yml installs to the matching ~/-path.
link_tree() {
  local src_dir="$1" dest_dir="$2" entry item target
  run mkdir -p "$dest_dir"
  for entry in "$src_dir"/*; do
    item=$(basename "$entry")
    if is_skipped "$item"; then
      skipped=$((skipped + 1))
      continue
    fi
    target="$dest_dir/$item"
    if [ -d "$entry" ] && [ ! -L "$entry" ]; then
      # Older installs linked the directory itself; replace that link with a
      # real dir so per-file links can be placed inside it.
      if [ -L "$target" ]; then
        case "$(readlink "$target")" in
          "$SRC"/*|"$DOTAGENTS_LINK"/*) run rm "$target" ;;
        esac
      fi
      if [ -e "$target" ] && [ ! -d "$target" ]; then
        printf 'CONFLICT: %s exists and is not a directory — leaving alone\n' "$target"
        conflicts=$((conflicts + 1))
        continue
      fi
      link_tree "$entry" "$target"
      continue
    fi
    # Codex skips a symlinked rules file: with sandbox-reads.rules linked, an
    # escalated `ps` still went to the auto-reviewer; copied, it did not. So the
    # rules are copies, rewritten whenever the repo's version differs. A real
    # file is ours only while it carries the header every repo rules file has.
    case "$target" in
      "$HOME/.codex/rules/"*.rules)
        if [ -f "$target" ] && [ ! -L "$target" ] && ! grep -qF "$RULES_MARK" "$target"; then
          printf 'CONFLICT: %s exists and is not a dotagents copy — leaving alone\n' "$target"
          conflicts=$((conflicts + 1))
          continue
        fi
        if [ -L "$target" ] || ! cmp -s "$entry" "$target"; then
          run rm -f "$target"
          run cp "$entry" "$target"
        fi
        linked=$((linked + 1))
        continue
        ;;
    esac
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      printf 'CONFLICT: %s exists and is not a symlink — leaving alone\n' "$target"
      conflicts=$((conflicts + 1))
      continue
    fi
    run ln -sfn "$entry" "$target"
    linked=$((linked + 1))
  done
}

for agent_dir in "$SRC"/*/; do
  [ -d "$agent_dir" ] || continue
  name=$(basename "$agent_dir")        # .claude, .agents, ...
  is_selected "$name" || continue
  agents_seen=$((agents_seen + 1))
  link_tree "${agent_dir%/}" "$HOME/$name"
done

if (( ! ONLY_MODE )) || is_selected ".agents"; then
# 3.5 Shell rc hook. Tools linked above need env vars/PATH in every shell;
# ~/.agents/env.sh carries those extensions, and each rc file gets a single
# source line appended once. The rc files themselves stay machine-owned —
# never symlinked or rewritten.
#
# ~/.profile is in the list for GUI-launched agent apps. They inherit the bare
# launchd environment (PATH=/usr/bin:/bin:/usr/sbin:/sbin, nothing else), so a
# var exported from .zshrc never reaches them. Hermes, for one, snapshots its
# environment from `bash -l -c` sourcing ~/.profile, ~/.bash_profile, ~/.bashrc
# — no zsh file is ever read. .profile is the only rc every such app agrees on.
ENV_SOURCE_LINE='[ -f "$HOME/.agents/env.sh" ] && . "$HOME/.agents/env.sh"  # dotagents'
rc_found=0
for rc in "$HOME/.profile" "$HOME/.bashrc" "$HOME/.zshrc"; do
  [ -f "$rc" ] || continue
  rc_found=1
  if ! grep -Fq '.agents/env.sh' "$rc"; then
    if (( DRY_RUN )); then
      printf 'DRY: append env.sh source line to %s\n' "$rc"
    else
      printf '\n%s\n' "$ENV_SOURCE_LINE" >> "$rc"
      printf 'HOOKED: %s now sources ~/.agents/env.sh\n' "$rc"
    fi
  fi
done
if (( ! rc_found )); then
  printf 'WARNING: no ~/.profile, ~/.bashrc or ~/.zshrc found; add manually: %s\n' "$ENV_SOURCE_LINE" >&2
fi
fi

if is_selected ".claude" || is_selected ".codex"; then
# 4. Settings assembly. Claude Code's only user-scope settings file is
# $HOME/.claude/settings.json — user-level settings.local.json is NOT read
# (only project-level .claude/settings.local.json exists). Install generates
# settings.json by deep-merging settings.shared.json + settings.<profile>.json
# (profile wins per key; nested objects merge, arrays replace). Claude writes
# runtime prefs (/model, permission prompts, /plugin) into the same file
# between installs. The repo owns each top-level key it sets; every other key
# the host has is kept. Claude also writes into permissions, enabledPlugins,
# extraKnownMarketplaces and pluginConfigs, so there the repo owns only its own
# entries: permission lists are unions (revoke with a deny rule), a host plugin
# entry stays only while enabled, plugin options merge per option, and a host
# marketplace with a directory source wins over the repo's of the same name
# (a mod developed from its checkout). Keys keep the host's order, so the diff
# printed shows only repo changes.
# Edit the repo files, never the generated one.
USER_SETTINGS="$HOME/.claude/settings.json"
SHARED_SETTINGS="$SRC/.claude/settings.shared.json"
LEGACY_LOCAL="$HOME/.claude/settings.local.json"

if is_selected ".claude"; then
# Migration from the symlink era: both files used to point into the repo.
if [ -L "$USER_SETTINGS" ]; then
  case "$(readlink "$USER_SETTINGS")" in
    "$SRC"/*|"$DOTAGENTS_LINK"/*)
      printf 'MIGRATE: %s symlink -> generated file\n' "$USER_SETTINGS"
      run rm "$USER_SETTINGS"
      ;;
  esac
fi
if [ -L "$LEGACY_LOCAL" ]; then
  case "$(readlink "$LEGACY_LOCAL")" in
    "$SRC"/*|"$DOTAGENTS_LINK"/*)
      printf 'MIGRATE: removing %s (user-level settings.local.json is not read by Claude Code)\n' "$LEGACY_LOCAL"
      run rm "$LEGACY_LOCAL"
      ;;
  esac
elif [ -f "$LEGACY_LOCAL" ]; then
  # A generated-file leftover from the short-lived settings.local.json design.
  # Harmful, not just dead weight: when Claude is started from $HOME, the file
  # loads as *project-local* settings (cwd/.claude/settings.local.json), which
  # outrank user settings and shadow the generated settings.json. Remove it if
  # it carries our hook marker; leave anything we can't identify as ours.
  if grep -q '\.dotagents/' "$LEGACY_LOCAL"; then
    printf 'MIGRATE: removing dotagents-generated %s (shadows user settings when Claude runs from $HOME)\n' "$LEGACY_LOCAL"
    if [ ! -e "$LEGACY_LOCAL.pre-dotagents.bak" ]; then
      run cp "$LEGACY_LOCAL" "$LEGACY_LOCAL.pre-dotagents.bak"
    fi
    run rm "$LEGACY_LOCAL"
  else
    printf 'NOTE: %s exists but Claude Code does not read user-level settings.local.json\n' "$LEGACY_LOCAL"
  fi
fi
fi

if [ -f "$SHARED_SETTINGS" ]; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "ERROR: jq is required to generate $USER_SETTINGS" >&2
    exit 1
  fi
  merge_inputs=("$SHARED_SETTINGS")
  # A profile may stack overlays, comma-separated and merged in order (`mac,work`).
  IFS=, read -ra profile_names <<<"$resolved_profile"
  for profile_name in ${profile_names[@]+"${profile_names[@]}"}; do
    profile_src="$SRC/.claude/settings.$profile_name.json"
    if [ -f "$profile_src" ]; then
      merge_inputs+=("$profile_src")
      if jq -e 'has("hooks")' "$profile_src" >/dev/null 2>&1; then
        printf 'WARNING: %s defines hooks — profile hook arrays replace shared ones per event\n' "$profile_src" >&2
      fi
    else
      printf 'WARNING: profile "%s" declared but %s not found\n' "$profile_name" "$profile_src" >&2
    fi
  done
  # Settings env values are literal, so the installer fills host.name (Claude
  # Code sends none): the machine's Omnigent host name when it has one, so the
  # APM can join Omnigent's usage to the harnesses' telemetry, else `hostname`.
  otel_host=$(awk '/^host:/ { h = 1; next } /^[^ ]/ { h = 0 }
    h && /^  name:/ { sub(/^  name:[ \t]*/, "")
      if (/^\047[^\047]*\047$/ || /^"[^"]*"$/) $0 = substr($0, 2, length($0) - 2)
      print; exit }' \
    "$HOME/.omnigent/config.yaml" 2>/dev/null || true)
  # ponytail: a plain host name only, since it is also written between TOML quotes; YAML escapes fall back.
  if [ -n "$otel_host" ] && ! [[ "$otel_host" =~ ^[A-Za-z0-9._-]+$ ]]; then
    printf 'WARNING: Omnigent host name %s is not plain [A-Za-z0-9._-]; OTel uses hostname\n' "$otel_host" >&2
    otel_host=
  fi
  [ -n "$otel_host" ] || otel_host=$(hostname 2>/dev/null || uname -n)
  merged=$(jq -s --arg host "$otel_host" '
    reduce .[] as $overlay ({}; . * $overlay)
    | if (.env.OTEL_RESOURCE_ATTRIBUTES // "") != ""
      then .env.OTEL_RESOURCE_ATTRIBUTES += ",host.name=" + $host else . end
  ' "${merge_inputs[@]}")
  # `dotagents` is install's own key, never Claude's: the work overlay's
  # telemetryRepos becomes Omnigent's allowlist (4.6) and is dropped from settings.
  telemetry_repos=$(jq -c '.dotagents.telemetryRepos // empty' <<<"$merged")
  merged=$(jq 'del(.dotagents)' <<<"$merged")
  if is_selected ".claude" && [ -f "$USER_SETTINGS" ]; then
    jq -r --slurpfile h "$USER_SETTINGS" '($h[0].extraKnownMarketplaces // {}) as $hm
      | (.extraKnownMarketplaces // {}) | to_entries[]
      | select($hm[.key].source.source? == "directory" and $hm[.key] != .value)
      | "NOTE: marketplace \(.key) keeps this host'\''s directory source \($hm[.key].source.path) over the repo'\''s (README: Local overrides)"' \
      <<<"$merged" 2>/dev/null || true
  fi
  if ! is_selected ".claude"; then
    :
  elif (( DRY_RUN )); then
    printf 'DRY: generate %s from: %s\n' "$USER_SETTINGS" "${merge_inputs[*]}"
    linked=$((linked + 1))
  else
    host_settings=/dev/null
    [ -f "$USER_SETTINGS" ] && host_settings=$USER_SETTINGS
    tmp=$(mktemp)
    if ! jq --slurpfile h "$host_settings" '
        ($h[0] // {}) as $h
        | $h + .
        | if .permissions and $h.permissions then .permissions |= ($h.permissions + .
            | reduce ("allow", "deny", "ask", "additionalDirectories") as $k (.;
                if .[$k] and $h.permissions[$k] then .[$k] = $h.permissions[$k] + (.[$k] - $h.permissions[$k]) else . end))
          else . end
        | if .autoMode and $h.autoMode then .autoMode |= ($h.autoMode + .
            | reduce ("allow", "soft_deny", "environment") as $k (.;
                if .[$k] and $h.autoMode[$k] then .[$k] = $h.autoMode[$k] + (.[$k] - $h.autoMode[$k]) else . end))
          else . end
        | if .enabledPlugins and $h.enabledPlugins then .enabledPlugins |= (. as $r
            | $h.enabledPlugins + $r | with_entries(select(.value == true or (.key as $k | $r | has($k)))))
          else . end
        | if .extraKnownMarketplaces and $h.extraKnownMarketplaces
          then .extraKnownMarketplaces |= $h.extraKnownMarketplaces + . + ($h.extraKnownMarketplaces
            | with_entries(select(.value.source.source? == "directory"))) else . end
        | if .pluginConfigs and $h.pluginConfigs then .pluginConfigs |= $h.pluginConfigs * . else . end
      ' <<<"$merged" > "$tmp"; then
      printf 'WARNING: %s is not a valid settings object; left unchanged\n' "$USER_SETTINGS" >&2
      rm -f "$tmp"
    else
      if [ -f "$USER_SETTINGS" ] && ! cmp -s "$tmp" "$USER_SETTINGS"; then
        # one-time safety copy before the first overwrite of a real file
        if [ ! -e "$USER_SETTINGS.pre-dotagents.bak" ]; then
          cp "$USER_SETTINGS" "$USER_SETTINGS.pre-dotagents.bak"
        fi
        printf 'UPDATED %s:\n' "$USER_SETTINGS"
        diff -u "$USER_SETTINGS" "$tmp" || true
      fi
      chmod 644 "$tmp"
      mv "$tmp" "$USER_SETTINGS"
      linked=$((linked + 1))
    fi
  fi

  # 4.6 A machine that keeps telemetry off lists the repos still allowed to
  # export; Omnigent reads ~/.omnigent/telemetry-allowlist.json at each session launch
  # and turns Claude Code and Codex telemetry on for a listed checkout (matched
  # by its origin, so every worktree counts). The file is ours only while it
  # says so (managedBy); a hand-written one is left alone.
  ALLOWLIST="$HOME/.omnigent/telemetry-allowlist.json"
  if is_selected ".claude" && [ -d "$HOME/.omnigent" ]; then
    allow_ep=$(jq -r '.env.OTEL_EXPORTER_OTLP_ENDPOINT // ""' <<<"$merged")
    ours=1
    # An empty file is a write cut short (ours); anything else without the marker is the user's.
    if [ -s "$ALLOWLIST" ] && ! jq -e '.managedBy == "dotagents"' "$ALLOWLIST" >/dev/null 2>&1; then
      ours=0
      printf 'WARNING: %s is not managed by dotagents; left alone\n' "$ALLOWLIST" >&2
    fi
    if (( ours )) && [ -n "$telemetry_repos" ] && [ -n "$allow_ep" ]; then
      want=$(jq -n --arg ep "$allow_ep" --argjson repos "$telemetry_repos" \
        '{managedBy: "dotagents", endpoint: $ep, repos: $repos}')
      if [ "$(jq -c . "$ALLOWLIST" 2>/dev/null)" != "$(jq -c . <<<"$want")" ]; then
        if (( DRY_RUN )); then
          printf 'DRY: write telemetry allowlist %s\n' "$ALLOWLIST"
        else
          allow_tmp=$(mktemp "$ALLOWLIST.XXXXXX")
          printf '%s\n' "$want" > "$allow_tmp" && mv "$allow_tmp" "$ALLOWLIST"
          printf 'UPDATED: %s\n' "$ALLOWLIST"
        fi
      fi
    elif (( ours )) && [ -f "$ALLOWLIST" ]; then
      if (( DRY_RUN )); then printf 'DRY: remove %s\n' "$ALLOWLIST"; else rm -f "$ALLOWLIST"; printf 'REMOVED: %s\n' "$ALLOWLIST"; fi
    fi
  fi

  # 4.5 Codex reads OTel only from ~/.codex/config.toml [otel]. Keep an owned
  # [otel] at its end, derived from the merged settings so the endpoint has one
  # source; telemetry off removes it. Owned = "[otel]", the marker line right
  # after it, then the contiguous keys written here. Codex rewrites the file
  # (`codex mcp add`) and inserts tables after that run, so nothing past it is
  # ours. Only a table header or EOF ends [otel]: blank and comment lines past
  # the run are kept for what follows, and a key after them (one the user added,
  # or ours split off by a comment) would fall into the previous table once the
  # header is gone, so it leaves the file alone. Any other otel table or key is
  # the user's. Codex 0.163.0 puts host.name on logs but not metrics, and
  # Omnigent filters its env, so `environment` carries the host; the Collector
  # copies it into host.name.
  CODEX_CONFIG="$HOME/.codex/config.toml"
  if is_selected ".codex" && [ -d "$HOME/.codex" ]; then
    otel_ep=$(jq -r 'if .env.CLAUDE_CODE_ENABLE_TELEMETRY == "1"
      then .env.OTEL_EXPORTER_OTLP_ENDPOINT // "" else "" end' <<<"$merged")
    otel_prompts=$(jq -r 'if .env.OTEL_LOG_USER_PROMPTS == "1" then "true" else "false" end' <<<"$merged")
    otel_mark='# dotagents otel: generated by bin/dotagents install from settings.*.json; edit there'
    codex_tmp=$(mktemp "$HOME/.codex/.config.toml.XXXXXX")
    codex_ok=1
    if [ -f "$CODEX_CONFIG" ]; then
      cp -p "$CODEX_CONFIG" "$codex_tmp"
      # Drop the owned block and one blank line around it.
      awk -v m="$otel_mark" '
        function flush() { if (hold) print ""; hold = 0 }
        function emit(l) { flush(); if (l == "") hold = 1; else print l }
        function done(  i) {
          st = 3
          for (i = 1; i <= n; i++) if (i > 1 || pre || buf[i] != "") emit(buf[i])
        }
        st == 2 {
          if (!n && $0 ~ /^(environment|log_user_prompt|log_agent_responses|exporter|metrics_exporter|trace_exporter)[[:space:]]*=/) next
          if ($0 == "" || $0 ~ /^[[:space:]]*#/) { buf[++n] = $0; next }
          if ($0 !~ /^[[:space:]]*\[/) { bad = 1; exit }
          done()
        }
        st == 1 {
          if ($0 == m) { st = 2; pre = hold; hold = 0; next }
          flush(); print "[otel]"; st = 0
        }
        st == 0 && $0 == "[otel]" { st = 1; next }
        $0 == "" { flush(); hold = 1; next }
        { flush(); print }
        END { if (bad) exit 3; if (st == 1) { flush(); print "[otel]" } if (st == 2) done(); flush() }
      ' "$CODEX_CONFIG" > "$codex_tmp" || codex_ok=0
    fi
    if (( ! codex_ok )); then
      printf 'WARNING: %s has keys after the dotagents [otel] block; not managed\n' "$CODEX_CONFIG" >&2
      rm -f "$codex_tmp"
    elif grep -Eq '^[[:space:]]*(\[+[[:space:]]*["'\'']?otel["'\'']?[[:space:]]*[].]|["'\'']?otel["'\'']?[[:space:]]*[.=])' "$codex_tmp"; then
      printf 'WARNING: %s has its own [otel]; dotagents otel block not managed\n' "$CODEX_CONFIG" >&2
      rm -f "$codex_tmp"
    else
      if [ -n "$otel_ep" ]; then
        if [ -s "$codex_tmp" ]; then echo >> "$codex_tmp"; fi
        printf '%s\n' '[otel]' "$otel_mark" "environment = \"$otel_host\"" "log_user_prompt = $otel_prompts" "log_agent_responses = $otel_prompts" \
          "exporter = { otlp-http = { endpoint = \"$otel_ep/v1/logs\", protocol = \"binary\" } }" \
          "metrics_exporter = { otlp-http = { endpoint = \"$otel_ep/v1/metrics\", protocol = \"binary\" } }" \
          'trace_exporter = "none"' >> "$codex_tmp"
      fi
      if { [ -f "$CODEX_CONFIG" ] || [ -s "$codex_tmp" ]; } && ! cmp -s "$codex_tmp" "$CODEX_CONFIG"; then
        if (( DRY_RUN )); then
          printf 'DRY: update otel block in %s\n' "$CODEX_CONFIG"
          rm -f "$codex_tmp"
        else
          printf 'UPDATED %s:\n' "$CODEX_CONFIG"
          if [ -f "$CODEX_CONFIG" ]; then
            cp -p "$CODEX_CONFIG" "$CODEX_CONFIG.dotagents-bak"
            codex_old="$CODEX_CONFIG"
          else
            codex_old=/dev/null
          fi
          diff -u "$codex_old" "$codex_tmp" || true
          mv "$codex_tmp" "$CODEX_CONFIG"
        fi
      else
        rm -f "$codex_tmp"
      fi
    fi
  fi
fi
fi

# 4.6 Codex's workspace-write sandbox refuses writes outside the workspace, so a
# gate that takes the ~/.apm lifecycle lock or writes the uv or mise caches asks
# to leave it, and each ask is a model call to the auto-reviewer (agent-skills
# #475). Install owns `writable_roots` in [sandbox_workspace_write]: the marker
# line and the key right after it. The paths that exist on this host are listed,
# absolute, since Codex does not expand `~` there; a missing root is skipped, as
# Linux's sandbox binds each one. The user's other keys stay. A `writable_roots`
# without the marker is the user's, so the file is left alone.
CODEX_WRITABLE_ROOTS=(.apm .cache/uv .local/share/mise .local/state/mise Library/Caches/mise)
CODEX_CONFIG="$HOME/.codex/config.toml"
if is_selected ".codex" && [ -d "$HOME/.codex" ]; then
  roots_mark='# dotagents sandbox: generated by bin/dotagents install (CODEX_WRITABLE_ROOTS); edit there'
  roots=()
  for root in "${CODEX_WRITABLE_ROOTS[@]}"; do
    [ -d "$HOME/$root" ] && roots+=("\"$HOME/$root\"")
  done
  # uv's cache can be set elsewhere (uv.toml cache-dir, UV_CACHE_DIR); ask uv.
  uv_cache=$(uv cache dir 2>/dev/null) || uv_cache=
  if [ -d "$uv_cache" ] && [ "$uv_cache" != "$HOME/.cache/uv" ]; then
    roots+=("\"$uv_cache\"")
  fi
  roots_line=
  if (( ${#roots[@]} )); then
    roots_line="writable_roots = [$(IFS=,; printf '%s' "${roots[*]}" | sed 's/,/, /g')]"
  fi
  src="$CODEX_CONFIG"; [ -f "$src" ] || src=/dev/null
  roots_tmp=$(mktemp "$HOME/.codex/.config.toml.XXXXXX")
  # Exit 3: a writable_roots key that is not ours.
  if awk -v m="$roots_mark" -v line="$roots_line" '
      skip { skip = 0; if ($0 ~ /^[[:space:]]*writable_roots[[:space:]]*=/) next }
      $0 == m { skip = 1; next }
      /^[[:space:]]*(sandbox_workspace_write[[:space:]]*\.[[:space:]]*)?writable_roots[[:space:]]*=/ { bad = 1 }
      { out[++n] = $0 }
      $0 ~ /^[[:space:]]*\[[[:space:]]*sandbox_workspace_write[[:space:]]*\][[:space:]]*(#.*)?$/ { at = n }
      END {
        if (bad) exit 3
        for (i = 1; i <= n; i++) {
          print out[i]
          if (i == at && line != "") { print m; print line }
        }
        if (!at && line != "") {
          if (n && out[n] != "") print ""
          print "[sandbox_workspace_write]"; print m; print line
        }
      }
    ' "$src" > "$roots_tmp"; then
    if ! cmp -s "$roots_tmp" "$src"; then
      if (( DRY_RUN )); then
        printf 'DRY: update sandbox writable_roots in %s\n' "$CODEX_CONFIG"
        rm -f "$roots_tmp"
      else
        printf 'UPDATED %s:\n' "$CODEX_CONFIG"
        [ -f "$CODEX_CONFIG" ] && cp -p "$CODEX_CONFIG" "$CODEX_CONFIG.dotagents-bak"
        diff -u "$src" "$roots_tmp" || true
        mv "$roots_tmp" "$CODEX_CONFIG"
      fi
    else
      rm -f "$roots_tmp"
    fi
  else
    rm -f "$roots_tmp"
    printf 'WARNING: %s sets its own writable_roots; dotagents sandbox roots not managed\n' "$CODEX_CONFIG" >&2
  fi
fi

# 4.7 Antigravity (agy) writes runtime state (trustedWorkspaces) into its own
# settings.json, so that file is never linked: install sets the keys of
# settings.shared.json in it and keeps the rest. Effort is part of agy's model
# name ("... (Low)"). Omnigent seeds each agy session's private copy from it.
AGY_SHARED="$SRC/.gemini/antigravity-cli/settings.shared.json"
AGY_SETTINGS="$HOME/.gemini/antigravity-cli/settings.json"
# agy writes the file on its first run; until then there is nothing to set.
if is_selected ".gemini" && [ -f "$AGY_SHARED" ] && [ -f "$AGY_SETTINGS" ]; then
  if ! agy_want=$(jq --slurpfile h "$AGY_SETTINGS" '($h[0] // {}) + .' "$AGY_SHARED" 2>/dev/null); then
    printf 'WARNING: %s is not a valid settings object; left unchanged\n' "$AGY_SETTINGS" >&2
  elif [ "$(jq -c . "$AGY_SETTINGS" 2>/dev/null)" != "$(jq -c . <<<"$agy_want")" ]; then
    if (( DRY_RUN )); then
      printf 'DRY: set %s keys in %s\n' "$AGY_SHARED" "$AGY_SETTINGS"
    else
      agy_tmp=$(mktemp "$AGY_SETTINGS.XXXXXX")
      # A write cut short (a full disk) must never replace the user's file.
      if printf '%s\n' "$agy_want" > "$agy_tmp" && chmod 600 "$agy_tmp"; then
        printf 'UPDATED %s:\n' "$AGY_SETTINGS"
        diff -u "$AGY_SETTINGS" "$agy_tmp" || true
        mv "$agy_tmp" "$AGY_SETTINGS"
      else
        rm -f "$agy_tmp"
        printf 'WARNING: could not write %s; left unchanged\n' "$AGY_SETTINGS" >&2
      fi
    fi
  fi
fi

# 4.8 Refresh each global skill install the pinned pack also has, so agents load
# the pinned version: a copy left by an older install keeps scripts the pack has
# dropped. Another installer or an agent may have put files there, so the copy
# replaced is moved to ~/.dotagents-bak/, its path flattened so no skill path
# matches it, replacing the previous backup of that skill. A link
# (~/.claude/skills/<n> -> ~/.agents/skills/<n>) follows its target.
if (( ! ONLY_MODE )) || is_selected ".agents"; then
  for skill_dir in "${SKILL_DIRS[@]:1}"; do
    for global in "$skill_dir"/*/; do
      global=${global%/}
      pack_skill="$PINNED_SKILLS/${global##*/}"
      { [ -L "$global" ] || [ ! -d "$pack_skill" ]; } && continue
      diff -rq -x __pycache__ "$pack_skill" "$global" >/dev/null 2>&1 && continue
      bak="$HOME/.dotagents-bak/$(printf '%s' "${global#"$HOME"/}" | tr / _)"
      run mkdir -p "$HOME/.dotagents-bak"
      run rm -rf "$bak"
      run mv "$global" "$bak"
      run cp -R "$pack_skill" "$global"
      (( DRY_RUN )) || printf 'REFRESHED: %s from the pinned pack; the old copy is in %s\n' "$global" "$bak"
    done
  done
fi

# 5. Validate
problems=0

# 4.9 Provide each tool a skill declares (skill_requirements), through the
# installer that already owns it, so a tool keeps one installation owner: a
# Homebrew copy is upgraded with brew; a missing tool, or one mise provides, with
# `mise use -g <tool>@latest`, linked into ~/.local/bin since env.sh puts mise's
# shims after the system dirs. Any other copy (a system package) is reported for
# its own package manager, never shadowed.
if (( ! ONLY_MODE )) || is_selected ".agents"; then
  brew_prefix=$(brew --prefix 2>/dev/null || true)
  while IFS='|' read -r tool min skill; do
    if requirement_met "$tool" "$min"; then
      printf 'TOOL: %s %s at %s, for skill %s%s\n' "$tool" "${REQ_HAVE:-(no version)}" \
        "$(PATH="$AGENT_PATH" command -v "$tool")" "$skill" "${min:+ (needs >= $min)}"
      continue
    fi
    found=$(PATH="$AGENT_PATH" command -v "$tool" 2>/dev/null || true)
    link="$HOME/.local/bin/$tool"
    if [ -n "$found" ] && [ -n "$brew_prefix" ] && [ "${found#"$brew_prefix"/}" != "$found" ]; then
      via=brew
      run brew upgrade "$tool" || true
    elif [ -z "$found" ] || [ "$found" = "$MISE_SHIMS/$tool" ] \
      || { [ "$found" = "$link" ] && [ "$(readlink "$link")" = "$MISE_SHIMS/$tool" ]; }; then
      via=mise
      if [ -e "$link" ] && [ ! -L "$link" ]; then
        printf 'CONFLICT: %s is a real file; skill %s needs %s >= %s\n' "$link" "$skill" "$tool" "${min:-any}"
        conflicts=$((conflicts + 1))
        continue
      fi
      if ! command -v mise >/dev/null 2>&1; then
        printf 'WARNING: skill %s needs %s%s, and mise is not installed to provide it\n' "$skill" "$tool" "${min:+ >= $min}" >&2
        problems=$((problems + 1))
        continue
      fi
      # mise fails, writing no config, when it can't provide the tool: a platform
      # its backend has no build for (ttyd's aqua package has none for macOS), or
      # an unreachable registry. Homebrew provides it then, where the host has it.
      if ! run mise use -g "$tool@latest" && [ -n "$brew_prefix" ]; then
        via=brew
        run brew install "$tool" || true
      fi
    else
      printf 'WARNING: %s %s at %s is too old for skill %s (needs >= %s); upgrade it with the package manager that installed it\n' \
        "$tool" "${REQ_HAVE:-(no version)}" "$found" "$skill" "$min" >&2
      problems=$((problems + 1))
      continue
    fi
    if (( ! DRY_RUN )) && ! requirement_met "$tool" "$min"; then
      printf 'WARNING: %s did not provide %s >= %s for skill %s\n' "$via" "$tool" "${min:-any}" "$skill" >&2
      problems=$((problems + 1))
      continue
    fi
    if [ "$via" = mise ]; then
      run mkdir -p "$HOME/.local/bin"
      run ln -sfn "$MISE_SHIMS/$tool" "$link"
    fi
    (( DRY_RUN )) && continue
    printf 'PROVIDED: %s %s via %s, for skill %s\n' "$tool" "$REQ_HAVE" "$via" "$skill"
  done < <(skill_requirements)
fi
if command -v jq >/dev/null 2>&1; then
  for f in "$HOME"/.claude/settings.json; do
    [ -e "$f" ] || continue
    if ! jq . "$f" >/dev/null 2>&1; then
      printf 'INVALID JSON: %s\n' "$f"
      problems=$((problems + 1))
    fi
  done
fi

# A family's frontier model above `top` (Claude Fable, Codex Astra) never runs,
# because it costs several times `top`. Install keeps host keys, so a default
# set on the host would go unnoticed: report it and leave it, since which model
# a host runs is the owner's call. Codex: top-level `model` and each
# [profiles.*] `model`, in the shared config and in each Omnigent session's
# private copy, which Omnigent makes only when it is missing, so a stale default
# outlives a fix to the shared file. Claude Code: settings.json `model`.
# ponytail: line-based TOML read, misses inline tables (profiles = { x = { model = .. } }).
frontier_rule='frontier models above top (Claude Fable, Codex Astra) never run; set a top-tier model'
codex_configs=()
for f in "$HOME/.codex/config.toml" "$HOME"/.omnigent/codex-native/*/codex-home/config.toml; do
  [ -f "$f" ] && codex_configs+=("$f")
done
if is_selected ".codex" && (( ${#codex_configs[@]} )); then
  while IFS= read -r hit; do
    printf 'WARNING: %s is a frontier model; %s\n' "$hit" "$frontier_rule" >&2
    problems=$((problems + 1))
  done < <(awk '
    FNR == 1 { tbl = "" }
    /^[[:space:]]*\[/ { tbl = $0; sub(/^[[:space:]]*/, "", tbl); if (match(tbl, /^[^]]*\]+/)) tbl = substr(tbl, 1, RLENGTH); next }
    /^[[:space:]]*[^#=]+=/ {
      k = $0; sub(/=.*/, "", k); gsub(/[[:space:]"'\'']/, "", k)
      v = $0; sub(/^[^=]*=[[:space:]]*/, "", v)
      if (!match(v, /^"[^"]*"|^'\''[^'\'']*'\''/)) next
      v = substr(v, 1, RLENGTH); t = tbl; gsub(/[[:space:]"'\'']/, "", t)
      if (((t == "" && (k == "model" || k ~ /^profiles\..+\.model$/)) || (t ~ /^\[profiles\./ && k == "model") || (t == "[profiles]" && k ~ /^.+\.model$/)) && tolower(v) ~ /astra|fable/)
        print FILENAME ": " (tbl == "" ? "" : tbl " ") k " = " v
    }' "${codex_configs[@]}")
fi
if is_selected ".claude" && command -v jq >/dev/null 2>&1 \
  && claude_model=$(jq -r '.model | strings | select(ascii_downcase | test("astra|fable"))' "$HOME/.claude/settings.json" 2>/dev/null) \
  && [ -n "$claude_model" ]; then
  printf 'WARNING: %s: model = "%s" is a frontier model; %s\n' "$HOME/.claude/settings.json" "$claude_model" "$frontier_rule" >&2
  problems=$((problems + 1))
fi

# Dangling-symlink check inside our managed dotdirs.
for agent_dir in "$SRC"/*/; do
  name=$(basename "$agent_dir")
  is_selected "$name" || continue
  dest="$HOME/$name"
  [ -d "$dest" ] || continue
  while IFS= read -r -d '' link; do
    if [ ! -e "$link" ]; then
      if (( DRY_RUN )) && is_legacy_skill_link "$link"; then
        continue
      fi
      printf 'DANGLING: %s\n' "$link"
      problems=$((problems + 1))
    fi
  done < <(find "$dest" -maxdepth 1 -type l -print0)
done

printf '\ndotagents install: %d agents, %d linked, %d skipped, %d conflicts, %d validation problems\n' \
  "$agents_seen" "$linked" "$skipped" "$conflicts" "$problems"

(( conflicts == 0 && problems == 0 ))
